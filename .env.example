# Tool Web 环境变量配置
# 复制此文件为 .env 并填入实际值

# 必需: JWT 签名密钥 (本地开发可运行 python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=

# 数据库连接 (默认 SQLite)
DATABASE_URL=sqlite:///./data/tool_web.db

# Admin 种子用户密码 (未设置则生成随机密码并在启动日志中输出)
ADMIN_PASSWORD=

# 允许的 CORS 来源 (逗号分隔)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8003

# Docker 内部 API 代理目标 (默认使用 Compose 服务名 backend)
DOCKER_API_PROXY_TARGET=http://backend:8000

# Docker 部署 - Docker Hub 用户名 (deploy.sh 使用)
DOCKER_USER=

# 远程服务器 SSH 连接信息 (deploy.sh 使用)
SSH_HOST=
SSH_USER=root
REMOTE_PATH=/opt/tool_web
