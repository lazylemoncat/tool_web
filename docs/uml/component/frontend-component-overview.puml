@startuml
title Frontend Component Overview

' Scope: Whole frontend component system at route, layout, domain component, shared component, hook, and external library level.
' Evidence:
' - frontend/.umirc.ts
' - frontend/src/layouts/index.tsx
' - frontend/src/pages/HomePage.tsx
' - frontend/src/pages/TodoPage.tsx
' - frontend/src/pages/finance/FinanceLayout.tsx
' - frontend/src/components/ui/index.ts
' - frontend/src/components/finance/FinanceCharts.tsx
' - docs/frontend-components.md
' Assumptions:
' - Domain folders are grouped as components to keep the frontend-wide diagram below the component diagram node limit.
' - Arrows represent observed compile-time imports or runtime composition through Umi routes, Outlet, providers, hooks, and shared components.

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

package "Frontend App" {
  component "Umi Route Config\n(frontend/.umirc.ts)" as UmiRoutes
  component "AppLayout\n(src/layouts/index.tsx)" as AppLayout
  component "AuthPage\n(components/auth)" as AuthPage
  component "AppTopBar\n(components/layout)" as AppTopBar
  component "Theme and I18n Runtime\n(context, i18n, theme)" as ThemeI18n
}

package "Pages and Feature Components" {
  component "Home Dashboard\n(pages/HomePage.tsx)" as HomePage
  component "Home Components\n(components/home)" as HomeComponents
  component "Todo Page\n(pages/TodoPage.tsx)" as TodoPage
  component "Todo Components\n(components/todo)" as TodoComponents
  component "Finance Routes\n(pages/finance)" as FinancePages
  component "Finance Components\n(components/finance)" as FinanceComponents
  component "Settings and Utility Pages\n(components/settings, pages/settings, pages/HelpPage, pages/UIPreviewPage)" as SettingsPages
}

package "Shared Frontend Layer" {
  component "UI Primitives\n(components/ui)" as UIPrimitives
  component "Common Components\n(components/common)" as CommonComponents
  component "Hooks\n(hooks, hooks/finance)" as Hooks
  component "API Client\n(api/client.ts)" as ApiClient
  component "Styles and Tokens\n(styles, theme CSS vars)" as Styles
}

package "External UI Libraries" {
  component "Radix UI" <<external>> as Radix
  component "dnd-kit" <<external>> as DndKit
  component "Recharts" <<external>> as Recharts
}

UmiRoutes --> AppLayout : wraps routes
AppLayout --> AuthPage : unauthenticated view
AppLayout --> AppTopBar : authenticated shell
AppLayout --> ThemeI18n : providers and theme switching
AppLayout --> ApiClient : saved theme fetch
AppLayout --> HomePage
AppLayout --> TodoPage
AppLayout --> FinancePages
AppLayout --> SettingsPages

HomePage --> HomeComponents : dashboard widgets and module cards
HomePage --> UIPrimitives
HomePage --> Hooks : dashboard data
HomePage --> DndKit : sortable management mode

TodoPage --> TodoComponents : task list, forms, detail drawers
TodoPage --> CommonComponents : search, toast, custom buttons
TodoPage --> Hooks : todos, folders, tags
TodoComponents --> DndKit : task and subtask sorting

FinancePages --> FinanceComponents : sidebar, forms, dashboard, lists
FinancePages --> Hooks : ledger and finance state
FinanceComponents --> Recharts : dashboard charts
FinanceComponents --> UIPrimitives

SettingsPages --> UIPrimitives
SettingsPages --> Hooks : theme and preference data
SettingsPages --> ApiClient

AppTopBar --> UIPrimitives
AppTopBar --> ThemeI18n
HomeComponents --> UIPrimitives
CommonComponents --> UIPrimitives
Hooks --> ApiClient
UIPrimitives --> Radix : headless primitives
UIPrimitives --> Styles
HomePage --> Styles
TodoPage --> Styles
FinancePages --> Styles

@enduml
